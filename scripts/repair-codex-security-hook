#!/usr/bin/env python3
"""Repair known security-guidance JSON output paths in the Codex plugin cache."""
from __future__ import annotations

import argparse
import ast
import os
from pathlib import Path
import tempfile

EMITTER = '    print(json.dumps(out), flush=True)'
FILTER = '''    if os.environ.get("PLUGIN_ROOT"):
        out.pop("metrics", None)
        out.pop("rewakeSummary", None)
'''
REPLACEMENTS = (
    ('print(json.dumps({"metrics": {"bash_hook_dedup": True}}), flush=True)',
     'emit_metrics({"bash_hook_dedup": True})'),
    ('print(json.dumps(output))',
     'emit_metrics(output["metrics"], additional_context=(output.get("hookSpecificOutput") or {}).get("additionalContext"))'),
)


def patch_source(source: str) -> str:
    """Accept the known original, partial repair, or our already repaired version."""
    ast.parse(source)
    if source.count(EMITTER) != 1 or 'def emit_metrics(' not in source:
        raise ValueError('알 수 없는 upstream 출력 함수; 자동 수정하지 않습니다')
    for before, after in REPLACEMENTS:
        if source.count(before) == 1 and after not in source:
            source = source.replace(before, after)
        elif before not in source and source.count(after) == 1:
            pass
        else:
            raise ValueError('알 수 없는 upstream 출력 경로; 자동 수정하지 않습니다')
    if FILTER not in source:
        if 'out.pop("metrics"' in source or 'out.pop("rewakeSummary"' in source:
            raise ValueError('기존 호환 처리 형식이 다릅니다; 자동 수정하지 않습니다')
        source = source.replace(EMITTER, FILTER + EMITTER)
    ast.parse(source)
    return source


def apply(path: Path) -> bool:
    original = path.read_text(encoding='utf-8')
    fixed = patch_source(original)
    if fixed == original:
        return False
    backup = path.with_suffix('.py.before-codex-json-fix')
    # Preserve the first original across repeated installs.
    if backup.exists() and backup.read_text(encoding='utf-8') != original:
        raise ValueError('백업과 현재 원본이 다릅니다; 기존 백업을 덮어쓰지 않습니다')
    if not backup.exists():
        with backup.open('x', encoding='utf-8') as stream:
            stream.write(original)
    with tempfile.NamedTemporaryFile(dir=path.parent, mode='w', encoding='utf-8', delete=False) as stream:
        temporary = Path(stream.name)
        stream.write(fixed)
    try:
        temporary.chmod(path.stat().st_mode & 0o777)
        os.replace(str(temporary), str(path))
    finally:
        temporary.unlink(missing_ok=True)
    return True


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--apply', action='store_true', help='백업 후 설치본에 적용; 기본은 확인만')
    parser.add_argument('--plugin-dir', type=Path, help='security-guidance 버전 디렉토리')
    args = parser.parse_args()
    root = Path.home() / '.codex/plugins/cache/claude-plugins-official/security-guidance'
    paths = ([args.plugin_dir / 'hooks/security_reminder_hook.py'] if args.plugin_dir else
             sorted(root.glob('*/hooks/security_reminder_hook.py')))
    if not paths:
        parser.error('Codex security-guidance 설치본을 찾지 못했습니다')
    try:
        # Validate every candidate before changing any installation.
        for path in paths:
            patch_source(path.read_text(encoding='utf-8'))
        for path in paths:
            pending = patch_source(path.read_text(encoding='utf-8')) != path.read_text(encoding='utf-8')
            if args.apply:
                changed = apply(path)
                status = '수정 완료' if changed else '이미 적용됨'
            else:
                status = '수정 필요' if pending else '이미 적용됨'
            print(f'{path}: {status}')
    except (OSError, ValueError, SyntaxError) as exc:
        parser.exit(1, str(exc) + '\n')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
