#!/usr/bin/env python3
"""session-start — P4 세션 시작 5단계를 훅이 강제한다. 모델 판단에 맡기지 않는다 (spec §4).

  1 작업 디렉토리  2 log.jsonl 마지막 항목 + 최근 커밋  3 최우선 미완 작업 (P2가 결정)
  4 e2e 스모크 (러너 모드에서는 밤 시작에 러너가 돌린 결과를 로그에서 보여준다)  5 기존 문제 먼저

.harness/ 가 없는 repo에서는 아무것도 하지 않는다 — 다른 repo에 플러그인이 있어도 무해.
출력: {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ...}}
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "runner"))
import harnesslib as H  # noqa: E402

LOG_LINES = 8


def fmt_event(e: dict) -> str:
    keep = {k: v for k, v in e.items() if k in ("task", "attempt", "stage", "reason", "ok", "commit", "exit") and v is not None}
    return "%s %s %s" % (e.get("ts", "?")[5:16], e.get("event", "?"), " ".join("%s=%s" % kv for kv in keep.items()))


def build(cwd: Path) -> str:
    repo = H.find_repo(cwd)
    if repo is None:
        return ""
    runner_mode = bool(os.environ.get("HARNESS_NIGHT"))
    git = H.Git(repo.root)
    lines = ["[harness] 세션 시작 5단계 (P4 — 훅이 강제한다. 건너뛰지 않는다)"]
    branch = git.run("rev-parse", "--abbrev-ref", "HEAD", check=False) or "?"
    try:
        private = H.load_domain(repo).is_private
    except H.HarnessError:
        private = False
    lines.append("1. 작업 디렉토리: %s (.harness/ 있음) · 브랜치 %s%s%s" % (repo.root, branch, " · 러너 모드 %s" % os.environ["HARNESS_NIGHT"] if runner_mode else "",
                                                            " · **비공개 repo(private)** — 네트워크·WebFetch·네트워크 스킬 금지, 웹 조회는 다른 세션에서" if private else ""))

    events = H.read_log(repo.log)
    lines.append("2. 최근 로그 (.harness/log.jsonl 마지막 %d줄%s):" % (LOG_LINES, "" if events else " — 비어 있음"))
    lines += ["   - " + fmt_event(e) for e in events[-LOG_LINES:]]
    commits = git.log_oneline(5)
    if commits:
        lines.append("   최근 커밋:")
        lines += ["   - " + c for c in commits.splitlines()]

    try:
        domain = H.load_domain(repo)
        _, tasks = H.load_plan(repo)
        plan_err = H.validate_plan(tasks, domain)
    except H.HarnessError as e:
        domain, tasks, plan_err = H.Domain({}), [], [str(e)]
    states = H.derive_states(events, tasks)
    tid = os.environ.get("HARNESS_TASK_ID")
    current = next((t for t in tasks if t.id == tid), None) if tid else None
    if current is None and not plan_err:
        current = H.select_next(tasks, states, domain)
    if current:
        st = states.get(current.id) or H.TaskState(id=str(current.id))
        lines.append("3. 현재 작업 (P2가 결정 — 직접 고르지 않는다): %s %s · 시도 %d (실패 %d/%d) · 검증기 `%s`%s" % (
            current.id, current.title, st.attempts + (0 if runner_mode else 1), st.failures, domain.max_attempts, current.verify_cmd,
            "" if runner_mode else " · (대화형: 러너가 돌리면 이 작업이 먼저 선택된다)"))
    else:
        lines.append("3. 현재 작업: 없음 — %s" % ("; ".join(plan_err) if plan_err else "자격 있는 작업이 없다 (계획을 채우거나 BLOCKED.md 확인)"))
    gates = [t for t in tasks if t.id and t.is_gate and (states.get(t.id) or H.TaskState(id=str(t.id))).state == "gate"]
    now_gates = [t for t in gates if H.gate_openable(t, states)]
    if now_gates:
        lines.append("   승인 대기 게이트(지금 열 수 있다): " + ", ".join("%s %s" % (t.id, t.title) for t in now_gates) + (
            " — 사람만 연다 (runner/queue approve)" if runner_mode else
            " — 사용자가 '승인'·'시작해'·'진행해' 라고 하면 `runner/queue approve <id> --note '…'` 를 실행한다 (부기는 프로그램, 결정은 사람)"))
    if len(gates) > len(now_gates):
        lines.append("   뒤에 올 게이트 %d개 — 선행 작업이 끝나야 열린다 (approve 가 거부한다)" % (len(gates) - len(now_gates)))

    if runner_mode:
        smoke = next((e for e in reversed(events) if e.get("event") == "smoke" and e.get("night") == os.environ["HARNESS_NIGHT"]), None)
        if smoke:
            lines.append("4. 스모크 (밤 시작에 러너가 실행, `%s`): %s (exit %s, %ss)" % (
                smoke.get("cmd"), "ok" if smoke.get("ok") else "실패", smoke.get("exit"), smoke.get("seconds")))
        else:
            lines.append("4. 스모크: 로그에 없음")
        last_pass = next((e for e in reversed(events) if e.get("event") == "task_passed"), None)
        if last_pass:
            lines.append("   마지막 green 커밋: %s (%s)" % (last_pass.get("commit"), last_pass.get("task")))
    else:
        head = git.run("rev-parse", "HEAD", check=False)
        clean = git.run("status", "--porcelain", check=False) == ""
        cache_path = repo.sessions / "verify-cache.json"
        cached = None
        if clean and head:
            try:
                c = json.loads(cache_path.read_text(encoding="utf-8"))
                if c.get("head") == head and c.get("cmd") == domain.verify_cmd and c.get("ok") is True:
                    cached = c
            except (OSError, ValueError):
                cached = None
        if cached:  # 같은 HEAD·clean 트리에서 이미 통과 — 매 세션 재실행하지 않는다 (캐시는 sessions/ 안, I9 무해. 실패는 캐시하지 않는다)
            lines.append("4. 스모크 `%s`: ok (캐시 — HEAD %s 에서 %s 통과. 트리가 바뀌면 다시 돈다)" % (domain.verify_cmd, head[:7], cached.get("ts", "?")))
        else:
            vr = H.run_verify(repo, domain.verify_cmd, min(domain.smoke_timeout, 540))
            last = [ln for ln in vr.tail.splitlines() if ln.strip()][-3:]
            lines.append("4. 스모크 `%s`: %s (exit %s, %.1fs)%s" % (vr.cmd, "ok" if vr.ok else "실패 — " + vr.reason, vr.exit, vr.seconds,
                                                              ("\n   " + "\n   ".join(last)) if (last and not vr.ok) else ""))
            if clean and head and vr.ok:
                try:
                    repo.sessions.mkdir(parents=True, exist_ok=True)
                    cache_path.write_text(json.dumps({"head": head, "cmd": domain.verify_cmd, "ok": True, "ts": H.iso(H.now())}), encoding="utf-8")
                except OSError:
                    pass
    lines.append("5. 기존 문제(4가 실패면 그것, 로그의 failed/blocked)를 먼저 해결한 뒤 새 작업을 시작한다.")
    lines.append("규칙: .harness/ 부기 파일 쓰기 금지 · git commit/push 금지 · ID·카운터 계산 금지 · 판정은 검증기가 한다 (당신의 done 아님).")
    marker = Path(__file__).resolve().parent.parent / ".installed-from"  # plugin-refresh 가 설치 때 쓴다 (repo 에서 직접 돌면 없음)
    try:
        sha, hroot = marker.read_text(encoding="utf-8").split()[:2]
        head = H.Git(Path(hroot)).run("rev-parse", "HEAD", check=False)
        if head and head != sha:
            lines.append("⚠ 하네스 설치본(%s)이 repo HEAD(%s)보다 뒤 — `scripts/plugin-refresh` 후 세션 재시작 (findings/008)" % (sha[:7], head[:7]))
    except (OSError, ValueError, IndexError):
        pass
    return "\n".join(lines)


def main() -> int:
    H.ensure_utf8_stdio()
    canary = os.environ.get("HARNESS_CANARY")
    if canary:  # 러너가 지정한 카나리아 — 존재 = "플러그인 훅이 로드됐고 돌 수 있다"의 증명 (없으면 드라이버가 즉시 중단).
        try:    # append: 줄 수 = 발화 횟수 — 전역 설치와 --plugin-dir 주입이 겹치면 2줄이 된다 (배송 결정의 이중 발화 감지)
            with open(canary, "a", encoding="utf-8") as f:
                f.write("%s pid=%d\n" % (H.iso(H.now()), os.getpid()))
        except OSError as e:
            print("session-start: 카나리아 쓰기 실패: %s" % e, file=sys.stderr)
    try:
        data = json.loads(sys.stdin.buffer.read().decode("utf-8", "replace"))
    except (ValueError, OSError):
        data = {}
    cwd = Path(data.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    try:
        ctx = build(cwd)
    except Exception as e:  # 훅이 세션을 죽이면 안 된다
        print("session-start: %s" % e, file=sys.stderr)
        return 1
    if ctx:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ctx}}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
