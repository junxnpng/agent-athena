#!/usr/bin/env python3
"""init — 대상 repo에 .harness/ 골격을 만든다 (계약 5개 + plan 템플릿 + .gitignore). 있는 파일은 덮지 않는다.

  runner/init --repo <path> [--force]
"""
from __future__ import annotations

import argparse
import shutil
import stat
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import harnesslib as H  # noqa: E402

TEMPLATE = H.HARNESS_ROOT / "templates" / "harness-dir"
EXECUTABLES = ("verify", "init.sh")


def main() -> int:
    H.ensure_utf8_stdio()
    ap = argparse.ArgumentParser()
    ap.add_argument("--repo", required=True)
    ap.add_argument("--force", action="store_true", help="기존 파일도 덮어쓴다 (log.jsonl 은 절대 덮지 않는다)")
    a = ap.parse_args()
    repo = H.Repo(Path(a.repo).resolve())
    if not repo.root.is_dir():
        print("init: 경로가 없다: %s" % repo.root, file=sys.stderr)
        return 2
    repo.hdir.mkdir(parents=True, exist_ok=True)
    written, skipped = [], []
    for src in sorted(TEMPLATE.iterdir()):
        if not src.is_file():
            continue
        dst = repo.hdir / src.name
        if dst.exists() and (not a.force or src.name == "log.jsonl"):
            skipped.append(src.name)
            continue
        shutil.copyfile(src, dst)
        if src.name in EXECUTABLES:
            dst.chmod(dst.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        written.append(src.name)
    print("생성: %s" % (", ".join(written) or "(없음)"))
    if skipped:
        print("유지: %s" % ", ".join(skipped))
    print("\n다음:\n  1. %s/spec.md 에 목표 3~5문장\n  2. %s/verify 를 진짜 검증기로 (exit 0 = pass)\n  3. %s/plan.json 에 리프 3개 (id 는 쓰지 않는다)\n  4. runner/decompose --check --repo %s\n  5. runner/night --repo %s --hours 0.5  (감독 하에)" % (
        repo.hdir, repo.hdir, repo.hdir, repo.root, repo.root))
    return 0


if __name__ == "__main__":
    sys.exit(main())
