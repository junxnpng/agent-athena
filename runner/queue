#!/usr/bin/env python3
"""queue — 큐 상태 / 다음 선택 / ID 발급+검증 (P2, P1). 상태는 전부 log.jsonl에서 파생한다 (I3).

  runner/queue status [--repo .] [--json]
  runner/queue next   [--repo .] [--json] [--remaining-minutes N]
  runner/queue load   [--repo .]            # id 없는 작업에 발급 + 계획 검증 + plan.json 갱신
  runner/queue unblock task-NNN --reason "..." [--repo .]   # 막힌 작업을 사람이 푼다 (task_unblocked 이벤트 append)
  runner/queue accept (--all | 인덱스...) [--repo .]        # decompose --propose 의 제안(plan.proposed.json)을 plan.json 에 넣는다 (id 발급·검증)
  runner/queue approve task-NNN [--note "..."] [--repo .]   # 승인 게이트(verify: "approval")를 사람이 연다 → task_approved (대화형에서 '승인'·'시작해'·'진행해')
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import harnesslib as H  # noqa: E402


def main() -> int:
    H.ensure_utf8_stdio()
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=["status", "next", "load", "unblock", "accept", "approve"])
    ap.add_argument("args", nargs="*", help="unblock/approve: task-NNN · accept: 제안 인덱스(0부터)")
    ap.add_argument("--note", default="", help="approve: 승인 메모")
    ap.add_argument("--reason", default="")
    ap.add_argument("--all", action="store_true", help="accept: 제안 전부")
    ap.add_argument("--by", default="human", help="accept 주체 기록 (human | auto)")
    ap.add_argument("--repo", default=".")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--remaining-minutes", type=float, default=None)
    a = ap.parse_args()
    repo = H.Repo(Path(a.repo).resolve())
    domain = H.load_domain(repo)
    meta, tasks = H.load_plan(repo)
    events = H.read_log(repo.log)

    if a.cmd == "load":
        new = H.assign_ids(tasks, events)
        errors = H.validate_plan(tasks, domain)
        if errors:
            print("계획 반려:\n - " + "\n - ".join(errors), file=sys.stderr)
            return 1
        if new:
            H.save_plan(repo, meta, tasks)
        print("발급: %s" % (", ".join(t.id for t in new) if new else "(없음 — 모두 id 있음)"))
        print("검증 통과: %d개 작업" % len(tasks))
        return 0

    states = H.derive_states(events, tasks)
    now_dt = H.now()
    if a.cmd == "unblock":
        task_id = a.args[0] if a.args else ""
        st = states.get(task_id)
        if st is None or st.state != "blocked":
            print("unblock: %s 는 blocked 상태가 아니다 (%s)" % (task_id or "(없음)", st.state if st else "없음"), file=sys.stderr)
            return 1
        H.append_event(repo.log, "task_unblocked", task=task_id, reason=a.reason or "사람이 해제", by="human")
        print("%s 해제 — 다음 밤에 다시 자격을 얻는다 (실패 횟수 0)" % task_id)
        return 0
    if a.cmd == "approve":
        task_id = a.args[0] if a.args else ""
        t = next((x for x in tasks if x.id == task_id), None)
        st = states.get(task_id)
        if t is None or not t.is_gate:
            print("approve: %s 는 승인 게이트(verify: approval)가 아니다" % (task_id or "(없음)"), file=sys.stderr)
            return 1
        if st is None or st.state != "gate":
            print("approve: %s 는 이미 %s 상태다" % (task_id, st.state if st else "없음"), file=sys.stderr)
            return 1
        git = H.Git(repo.root)
        was_clean = git.is_clean()
        H.append_event(repo.log, "task_approved", task=task_id, note=a.note or None, by=a.by)
        sha = git.commit_all("[harness] approve %s" % task_id) if was_clean else None
        unlocked = [x.id for x in tasks if task_id in x.depends_on]
        print("승인: %s %s%s%s" % (task_id, t.title, (" → 자격: %s" % ", ".join(map(str, unlocked))) if unlocked else "",
                                  (" · 부기 커밋 %s" % sha) if sha else (" · (트리가 clean 이 아니어서 커밋하지 않음)" if not was_clean else "")))
        return 0
    if a.cmd == "accept":
        if not a.all and not a.args:
            print("accept: 제안 인덱스(0부터)를 주거나 --all", file=sys.stderr)
            return 1
        git = H.Git(repo.root)
        was_clean = git.is_clean()
        chosen = H.accept_proposed(repo, domain, events, None if a.all else [int(x) for x in a.args])
        ids = [str(t.id) for t in chosen]
        H.append_event(repo.log, "plan_accepted", ids=ids, by=a.by)
        sha = git.commit_all("[harness] plan accept (%s)" % ", ".join(ids)) if was_clean else None
        print("채택: %s%s" % (", ".join(ids), (" · 부기 커밋 %s" % sha) if sha else (" · (트리가 clean 이 아니어서 커밋하지 않음)" if not was_clean else "")))
        return 0
    if a.cmd == "next":
        t = H.select_next(tasks, states, domain, now_dt, a.remaining_minutes)
        if t is None:
            print("null" if a.json else "(자격 있는 작업 없음)")
            return 0
        print(json.dumps(t.to_json(), ensure_ascii=False) if a.json else "%s %s (priority %d, %d분)" % (t.id, t.title, t.priority, t.estimate_minutes))
        return 0

    if repo.proposed.exists():
        _, pending = H.read_proposed(repo)
        print("제안 대기: %d개 (%s) → runner/queue accept --all | 인덱스" % (len(pending), H.PROPOSED_NAME))
    order = {t.id: i + 1 for i, t in enumerate(H.rank(tasks, states, domain, now_dt))}
    rows = []
    for t in tasks:
        st = states.get(t.id) or H.TaskState(id=str(t.id))
        rows.append({"id": t.id, "state": st.state, "attempts": st.attempts, "failures": st.failures,
                     "priority": t.priority, "estimate": t.estimate_minutes, "waited_min": round(H.waited_minutes(st, now_dt)),
                     "order": order.get(t.id), "origin": t.origin, "title": t.title})
    if a.json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return 0
    print("%-9s %-8s %3s %3s %4s %4s %7s %5s  %s" % ("id", "state", "att", "fail", "prio", "est", "waited", "next", "title"))
    for r in rows:
        print("%-9s %-8s %3d %3d %4d %4d %6dm %5s  %s" % (r["id"] or "-", r["state"], r["attempts"], r["failures"], r["priority"],
                                                        r["estimate"], r["waited_min"], r["order"] or "-", r["title"]))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except H.HarnessError as e:
        print("queue: %s" % e, file=sys.stderr)
        sys.exit(2)
